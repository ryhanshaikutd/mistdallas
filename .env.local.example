# Copy to .env.local and fill in. Never commit .env.local.
#   cp .env.local.example .env.local

# ── Supabase (required) ───────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>
# Server-only. Bypasses Row Level Security — keep it out of the browser.
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# ── Google Calendar / Meet (optional) ─────────────────────────────────────────
# Used by /api/interviews/book to create calendar events with Meet links.
# If unset, bookings still save but without a Meet link. See SETUP.md step 3.
GOOGLE_SERVICE_ACCOUNT_EMAIL=<service-account>@<project>.iam.gserviceaccount.com
# Paste the private_key from the service-account JSON as one line, keeping the \n escapes.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Calendar ID of the board calendar shared with the service account.
GOOGLE_CALENDAR_ID=<id>@group.calendar.google.com

# ── 2027 Handbook data sync (optional) ────────────────────────────────────────
# scripts/sync-handbook-data.mjs reads the old organizer portal's Supabase project
# with its publishable key; both default to the public handbook project.
# HANDBOOK_SUPABASE_URL=https://pgdrhoifisonmzuaeetu.supabase.co
# HANDBOOK_SUPABASE_ANON_KEY=sb_publishable_...

# ── Email (Resend) and the daily reminder cron ────────────────────────────────
# Decision emails and deadline reminders are skipped (not failed) when unset.
RESEND_API_KEY=<resend api key>
RESEND_FROM_EMAIL="MIST Dallas <board@mistdallas.org>"
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cron/reminders.
CRON_SECRET=<long random string>
# Absolute URL used in email links; defaults to https://mistdallas.org.
NEXT_PUBLIC_SITE_URL=https://mistdallas.org
